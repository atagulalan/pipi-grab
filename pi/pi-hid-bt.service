[Unit]
Description=pipi.grab Bluetooth RFCOMM control server
After=bluetooth.service hid-gadget.service
Wants=bluetooth.service

[Service]
Type=simple
User=root
WorkingDirectory=__PI_HOME__/pi-hid/webui
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=__PI_HOME__/pi-hid/webui:__PI_HOME__/pi-hid/python
ExecStartPre=/bin/sleep 2
ExecStartPre=/usr/sbin/rfkill unblock bluetooth
ExecStartPre=/bin/bash -c 'hciconfig hci0 up; bluetoothctl power on; bluetoothctl pairable on; bluetoothctl discoverable on; bluetoothctl discoverable-timeout 0 || true'
ExecStart=__PI_HOME__/pi-hid/hid-venv/bin/python -u __PI_HOME__/pi-hid/webui/bt_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
