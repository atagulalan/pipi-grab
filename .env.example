# Copy to .env and fill in. Never commit .env.

# Pi SSH (WiFi mode)
PIPI_HOST=pipi.local
PIPI_USER=pi
PIPI_PASS=changeme

# Bluetooth RFCOMM (BT mode) — Pi adapter MAC
PIPI_BT=AA:BB:CC:DD:EE:FF
PIPI_BT_CH=1

# wifi | bt
PIPI_MODE=wifi

# Optional remote agent command
# PIPI_REMOTE=cd ~/pi-hid/webui && ../hid-venv/bin/python -u agent.py

# Set to 1 to skip SSH auto-install of Pi HID files on ./run.sh
# PIPI_SKIP_ENSURE=0
# Set to 1 to ignore .ensure_ok stamp and re-check/install
# PIPI_FORCE_ENSURE=0
