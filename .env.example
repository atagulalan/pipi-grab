# Copy to .env and fill in. Never commit .env.

# Pi SSH (WiFi mode)
PIPI_HOST=pipi.local
PIPI_USER=pi
PIPI_PASS=changeme

# Bluetooth RFCOMM (BT mode) — Pi adapter MAC
PIPI_BT=AA:BB:CC:DD:EE:FF
PIPI_BT_CH=1

# wifi | bt
PIPI_MODE=wifi

# Optional ports / remote agent command
PIPI_UI_PORT=8765
PIPI_GRAB_PORT=8765
# PIPI_REMOTE=cd ~/pi-hid/webui && ../hid-venv/bin/python -u agent.py
